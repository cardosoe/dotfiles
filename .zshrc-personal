# Configurar que el retroceso (Backspace) funcione correctamente en modo inserción
bindkey '^?' backward-delete-char
bindkey '^H' backward-delete-char


# Cambiar la forma del cursor según el modo (Barra para Insertar, Bloque para Normal)
function zle-keymap-select {
  if [[ ${KEYMAP} == vicmd ]]; then
    echo -ne '\e[2m' # Cursor de bloque (Normal)
  else
    echo -ne '\e[5m' # Cursor de barra vertical (Insertar)
  fi
}
zle -N zle-keymap-select

# Asegurar que inicie en modo inserción con la barra vertical
_fix_cursor() { echo -ne '\e[5m' }
precmd_functions+=(_fix_cursor)


# Sincronizar el "yank" de Zsh con el portapapeles del sistema
vi-yank-to-clipboard() {
  zle vi-yank
  if command -v wl-copy &> /dev/null; then
    echo -n "$CUTBUFFER" | wl-copy
  elif command -v xclip &> /dev/null; then
    echo -n "$CUTBUFFER" | xclip -selection clipboard
  fi
}
zle -N vi-yank-to-clipboard
bindkey -M vicmd 'y' vi-yank-to-clipboard


# Cargar el editor de línea de comandos nativo de Zsh
