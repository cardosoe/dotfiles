# A partir de ahora, cada vez que modifiques cualquier archivo de tus dotfiles, solo tendrás que escribir:
# dotcommit "descripción de lo que cambiaste"

dotcommit() {
    config add -u
    config commit -m "${1:-update dotfiles}"
    config push
}

